{
  "name": "proofcheck",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "tesseract.js"
    ],
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.10",
      "brace-expansion": ">=5.0.8",
      "minimatch": ">=9.0.5",
      "@hono/node-server": ">=2.0.5"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "favicon": "tsx scripts/generate-favicon.ts app/favicon.ico",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx eval/run.ts",
    "eval:real-world": "tsx eval/run.ts --set real-world --provider local-ocr",
    "eval:history": "tsx eval/print-history.ts",
    "check-latency": "tsx scripts/check-latency.ts",
    "diagnose:ocr-langs": "tsx scripts/diagnose-ocr-langs.ts",
    "diagnose:ocr-latency": "tsx scripts/diagnose-ocr-latency.ts",
    "e2e": "playwright test",
    "samples": "tsx eval/generate-samples.ts",
    "samples:degraded": "tsx eval/generate-degraded.ts",
    "samples:romance": "tsx eval/generate-romance-samples.ts",
    "spike:ocr": "tsx scripts/spike-ocr.ts",
    "eval:adversarial": "tsx eval/run.ts --set adversarial --provider local-ocr",
    "eval:batch": "tsx eval/run.ts --set batch --provider mock",
    "eval:compare": "tsx eval/compare-escalation.ts",
    "eval:escalate": "tsx eval/run.ts --escalate",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "papaparse": "^5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
