# ProofCheck runs fully WITHOUT any of these (mock + local-ocr tiers).
# Set one key to enable the cloud extraction tier.

# Escalation ladder (self-correcting re-read of weakly-extracted fields). OFF by default: measured,
# it cost ~72% more cloud latency and ~55% more model calls for a NULL accuracy gain — see
# docs/superpowers/plans/2026-07-24-escalation-eval-results.md. Set to 1 to enable server-wide; dev
# mode also has a per-request "Ladder on" switch for demonstrating it.
# ESCALATION_ENABLED=1

# Gates the devTier / devBedrockModel / escalate request fields (tier override, model override,
# ladder opt-in — all cloud-cost multipliers) in production. Unset in production: those three fields
# are inert and a request carrying any of them gets a 400. Always on in development. See the
# "Cost/resource exhaustion" row of docs/ARCHITECTURE.md.
# DEV_CONTROLS_ENABLED=1

# OCR language pack(s) for the keyless local-ocr tier (default: eng).
# English-only is MEASURED, not an oversight: over the 46-label real-world set, adding fra/spa/ita/por
# changed ZERO overall verdicts (23/46 in every configuration) while costing 3.3x p95 latency and
# pushing max past the 5 s budget (2414 -> 7136 ms). Tesseract scores candidates against every loaded
# model, so cost scales with language count. Also, lib/ttb/normalize.ts already folds diacritics
# before comparison, so the matcher is accent-blind by design.
# Set this to restore packs knowingly — legitimate cases: 27 CFR 5.55(c) permits all-Spanish mandatory
# info for labels bottled for Puerto Rico, and wine (27 CFR part 4) carries no English requirement.
# OCR_LANGS=eng+spa

# Force a tier: mock | local-ocr | local-llm | bedrock (default: auto)
# Mainly for eval/CI. NOTE: this is checked BEFORE the "genuine bundled sample -> mock fixture" gate,
# so forcing a real tier makes the demo gallery's curated "passes"/"fails" outcomes depend on a live
# model rather than their fixtures. For everyday local dev, leave it unset and let key priority
# decide; to try another tier ad hoc, use dev mode's tier switcher (per-request, sample-safe).
# VISION_PROVIDER=

# AWS_BEARER_TOKEN_BEDROCK=  # enables the Bedrock cloud tier (Claude Haiku 4.5 by default — best of several models measured on the real-world eval set); optional BEDROCK_REGION (default us-east-2), BEDROCK_MODEL, BEDROCK_TIMEOUT_MS

# Local vision LLM via Ollama — keyless, fully local. Requires Ollama running with the model
# pulled (`ollama pull qwen2.5vl:3b`) and VISION_PROVIDER=local-llm (never auto-selected).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:3b
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=60000

# Per-IP rate limiting on /api/verify and /api/batch (lib/rate-limit.ts). In-memory, per-instance
# (not distributed), sliding window; defaults to 60 requests / 60s if unset.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# The limiter keys on the client-supplied X-Forwarded-For header, which is NOT trusted by default —
# every request shares one global bucket instead, so a forged/rotating header can't mint a fresh
# quota. Set to 1 ONLY on a deployment where a trusted upstream proxy (e.g. Vercel's edge) actually
# sets that header, to get a real per-IP quota instead of the coarser global cap.
# TRUST_PROXY_HEADERS=1
